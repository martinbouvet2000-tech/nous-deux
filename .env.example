# Copie ce fichier en .env.local (jamais commité) et remplis les valeurs depuis
# Supabase → Project Settings → API. La clé "publishable" (anon) est faite pour être
# embarquée côté client : la sécurité repose sur les RLS (voir supabase/migrations).
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Sous-chemin de déploiement. Vide en local / Vercel / Netlify.
# GitHub Pages (https://<user>.github.io/nous-deux-app/) : /nous-deux-app/
# VITE_BASE=/nous-deux-app/

# Notifications push : clé PUBLIQUE VAPID, embarquée côté client (elle voyage dans
# chaque abonnement). La clé privée correspondante n'est jamais dans le dépôt : elle
# vit dans Supabase Vault sous le nom « vapid_private_key », avec « push_hook_secret ».
VITE_VAPID_PUBLIC_KEY=BLPUolQ6fYI14JwalQk3erFyiwU-hqcIkqhBg5DwPEWhsHXh-aFnzk4sd9BXH5IuQfIh4wiKZ6C_yaN_RnniTCQ
